# Copiar este archivo como .env y reemplazar solamente los valores locales.
# Nunca subir el archivo .env real.
# Opción A (local): variables sueltas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adopplant
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_LOCAL
# Solo si la base exige TLS (Neon): require
DB_SSLMODE=

# Opción B (Neon/Render): una sola URL. La API usa _POOLED si existe;
# las migraciones de Alembic usan DATABASE_URL (conexión directa).
# DATABASE_URL=postgresql://usuario:clave@ep-xxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_POOLED=postgresql://usuario:clave@ep-xxx-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Generar una clave aleatoria de al menos 64 caracteres para cada entorno.
JWT_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES
JWT_ACCESS_TOKEN_MINUTES=30

# Configurar un solo proveedor en Render y, opcionalmente, en el .env local.
# Mailjet: clave pública, clave secreta y correo remitente verificado.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=

# Fotografías de plantas (solo servidor)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo sigue disponible si el registro de Mailjet tampoco es viable.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
