# Copiar este archivo como .env y reemplazar solamente los valores locales.
# Nunca subir el archivo .env real.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adopplant
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_LOCAL

# Generar una clave aleatoria de al menos 64 caracteres para cada entorno.
JWT_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES
JWT_ACCESS_TOKEN_MINUTES=30

# Brevo: crear una clave API v3 y verificar el correo remitente en Brevo.
# Configurar estas mismas variables en Render; no publicar sus valores reales.
BREVO_API_KEY=REEMPLAZAR_CON_CLAVE_API_BREVO
BREVO_SENDER_EMAIL=remitente-verificado@example.com
