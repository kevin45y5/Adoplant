              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const s = pm.response.json(); pm.environment.set(\"solicitud_id\", s.id_solicitud); pm.test(\"Estado pendiente\", () => pm.expect(s.estado).to.eql(\"PENDIENTE\")); pm.test(\"ID y fecha\", () => { pm.expect(s.id_solicitud).to.be.a(\"number\"); pm.expect(s.fecha_solicitud).to.be.a(\"string\"); }); }"
                ]
              }
            }
          ]
