{
  "info": {
    "name": "SCRUM-6 - Gestión de solicitudes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Envío, consultas privadas, edición y retiro. Seleccionar el entorno local existente. Ejecutar cada carpeta en orden. La carpeta 02 crea o reutiliza una solicitud de prueba y la retira al final; las notificaciones se conservan. Ver docs/SCRUM-6-postman.md."
  },
  "item": [
    {
      "name": "01 Enviar solicitud y validaciones",
      "item": [
        {
          "name": "Login adoptante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"identificador\": \"{{correo_adoptante}}\", \"contrasena\": \"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
