    {
      "name": "02 Consultar, corregir y retirar",
      "item": [
        {
          "name": "Login adoptante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"identificador\": \"{{correo_adoptante}}\", \"contrasena\": \"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "01 Preparar solicitud propia (crear o reutilizar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/solicitudes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"id_planta\":{{planta_disponible}},\"mensaje\":\"Solicitud para probar consulta, edición y retiro\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creada o ya existente\", () => pm.expect(pm.response.code).to.be.oneOf([201,409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Listar enviadas y guardar ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/solicitudes?tipo=enviadas&estado=PENDIENTE&id_planta={{planta_disponible}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.unset(\"solicitud_id\");",
                  "if (pm.response.code === 200) { const lista=pm.response.json(); pm.test(\"Hay una solicitud propia pendiente\", () => pm.expect(lista.length).to.eql(1)); if (lista.length === 1) pm.environment.set(\"solicitud_id\", lista[0].id_solicitud); }"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Consultar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/solicitudes/{{solicitud_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Corregir mensaje",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/solicitudes/{{solicitud_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"mensaje\": \"Tengo espacio, luz y tiempo para cuidarla.\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test(\"Mensaje actualizado\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Tengo espacio, luz y tiempo para cuidarla.\"));"
                ]
              }
            }
          ]
        },
