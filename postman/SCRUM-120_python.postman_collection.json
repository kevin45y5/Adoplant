    {
      "name": "C-SEC-05: login incorrecto (repetir 5 veces)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identificador\": \"{{correo_usuario}}\", \"contrasena\": \"Incorrecta120!\"}",
